// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    And(a = b, b = sel, out = arg1);
    Not(in = sel, out = notsel);
    And(a = notsel, b  = a, out = arg2);
    Or(a = arg1, b = arg2, out = out);
}