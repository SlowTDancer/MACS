// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in = a, out = nota);
    Not(in = b, out = notb);
    And(a = a, b = notb, out = arg1);
    And(a = nota, b = b, out = arg2);
    Or(a = arg1, b = arg2, out = out);
}