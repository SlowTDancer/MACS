// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Mux16(a = case2, b = false, sel = reset, out = case1);
    Mux16(a = case3, b = in, sel = load, out = case2);
    Mux16(a = res, b = rt, sel = inc, out = case3);
    Inc16(in = res, out = rt);
    Register(in = case1, load = true, out = res, out = out);
}
