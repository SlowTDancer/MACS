/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static Array ram;
    static Array heap;
    static int freeList;

    /** Initializes the class. */
    function void init() {
        let heap = 2048;
        let freeList = heap;
        let heap[0] = 0;
        let heap[1] = 14334;
        let ram = 0;
        
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }
    
    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int prev, prev_size, next, curr_seg, curr_size, result;
        var boolean found;

        let prev_size = 32767;
        let prev = -1;
        let found = false;
        let next = 0;
        
        while (~found) {
            let curr_seg = next;
            let next = heap[curr_seg];
            let curr_size = heap[curr_seg + 1];
            
            if ((curr_size > (size + 1) & (curr_size < prev_size))) {
                let prev = curr_seg;
                let prev_size = curr_size;
            }

            if (next = 0) {
                let result = prev + prev_size + 2 - size;
                let heap[result - 1] = size;
                let heap[result - 2] = 0;
                let heap[prev + 1] = (heap[prev + 1] - size - 2);
                let found = true;
            }
        }

        return result;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int segment;

        let segment = heap[segment];
        
        while (heap[segment] > 0) {
            let segment = heap[segment];
        }
        
        let heap[segment] = o - 2;
        return;
    }    
}
