     // ok
-  } else {
+  } else if(r_scause() == 15){
+    uint64 va = PGROUNDDOWN(r_stval());
+    pagetable_t pgt = p->pagetable;
+    if(haru(pgt, va) < 0){
+      setkilled(p);
+    }
+  }else {
     printf("usertrap(): unexpected scause %p pid=%d\n", r_scause(), p->pid);
     printf("            sepc=%p stval=%p\n", r_sepc(), r_stval());
     setkilled(p);
