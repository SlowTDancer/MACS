diff --git a/kernel/trap.c b/kernel/trap.c
index 512c850..b0435db 100644
--- a/kernel/trap.c
+++ b/kernel/trap.c
@@ -29,6 +29,41 @@ trapinithart(void)
   w_stvec((uint64)kernelvec);
 }
 
+
+int haru(pagetable_t pgt, uint64 va){
+  if(va >= MAXVA)
+    return -1;
+  
+  uint64 pa;
+  uint flags;
+  pte_t *pte;
+  char* mem;
+
+  if((pte = walk(pgt, va, 0)) == 0)
+    return -1;
+
+  if(!((*pte & PTE_V) && (*pte & PTE_U) && (*pte & PTE_COW)))
+    return -1;
+
+  pa = PTE2PA(*pte);
+  flags = PTE_FLAGS(*pte);
+  flags = flags | PTE_W;
+  flags = flags ^ PTE_COW;
+
+  if((mem = kalloc()) == 0)
+    return -1;
+
+  memmove(mem, (char*)pa, PGSIZE);
+  uvmunmap(pgt, va, 1, 1);
+  if(mappages(pgt, va, PGSIZE, (uint64)mem, flags) != 0){
+    kfree(mem);
+    return -1;
+  }
+
+  return 0;
+}
+
+
 //
 // handle an interrupt, exception, or system call from user space.
 // called from trampoline.S
