+
+uint64 
+sys_trace(void){
+    int mask;
+
+    argint(0, &mask);
+
+    myproc()->mask = mask;
+
+    return 0;
+}
+
+
+uint64 
+sys_sysinfo(void){
+    uint64 toSend;
+    struct sysinfo toGet;
+
+    argaddr(0, &toSend);
+
+    toGet.freemem = getFreeMem();
+    toGet.nproc = getNProc();
+    
+    if(copyout(myproc()->pagetable, toSend, (char *)&toGet, sizeof(toGet)) < 0)
+      return -1;
+
+    return 0;
+}
