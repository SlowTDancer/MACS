@@ -80,3 +80,17 @@ kalloc(void)
     memset((char*)r, 5, PGSIZE); // fill with junk
   return (void*)r;
 }
+
+uint64 getFreeMem(void){
+  uint64 res = 0;
+  struct run *page;
+  acquire(&kmem.lock);
+  page = kmem.freelist;
+  while(page){
+    res += PGSIZE;
+    page = page->next;
+  }
+  release(&kmem.lock);
+
+  return res;
+}
