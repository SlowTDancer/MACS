@@ -133,3 +134,20 @@ printfinit(void)
   initlock(&pr.lock, "pr");
   pr.locking = 1;
 }
+
+void
+backtrace(void){
+  uint64 fp = r_fp();
+  uint64 lsf = PGROUNDDOWN(fp);
+
+  printf("backtrace:\n");
+  
+  while (lsf <= fp && fp < lsf + PGSIZE){
+    uint64 ra = fp - 8, sfp = fp - 16;
+    
+    printf("%p\n", *(uint64 *)ra);
+
+    lsf = PGROUNDDOWN(fp);
+    fp = *(uint64 *)sfp;
+  }
+}
