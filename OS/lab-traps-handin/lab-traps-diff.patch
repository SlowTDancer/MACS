+uint64
+sys_sigalarm(void)
+{
+  int ticks;
+  uint64 handler;
+  argint(0, &ticks);
+  argaddr(1, &handler);
+  myproc()->alarmInterval = ticks;
+  myproc()->alarmHandler = (void*) handler;
+  return 0;
+}
+
+uint64
+sys_sigreturn(void)
+{
+  *myproc()->trapframe = myproc()->sd->trapframe;
+  myproc()->ticks = 0;
+  return myproc()->trapframe->a0;
+}
